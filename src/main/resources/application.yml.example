spring:
  cloud:
    gateway:
      server:
        webmvc:
          routes:

            - id: auth-service-auth
              uri: http://localhost:8081
              predicates:
                - Path=/api/v1/auth/**

            - id: auth-service-user
              uri: http://localhost:8082
              predicates:
                - Path=/api/v1/user/**

            - id: product-service-chain
              uri: http://localhost:8082
              predicates:
                - Path=/api/v1/chain/**

            - id: product-service-brand
              uri: http://localhost:8082
              predicates:
                - Path=/api/v1/brand/**

            - id: product-service-category
              uri: http://localhost:8082
              predicates:
                - Path=/api/v1/category/**

            - id: product-service-customization
              uri: http://localhost:8082
              predicates:
                - Path=/api/v1/customization/**

            - id: product-service-product
              uri: http://localhost:8082
              predicates:
                - Path=/api/v1/product/**

            - id: product-service-service
              uri: http://localhost:8082
              predicates:
                - Path=/api/v1/service/**

            - id: product-service-sku
              uri: http://localhost:8082
              predicates:
                - Path=/api/v1/sku/**

            - id: product-service-skutier
              uri: http://localhost:8082
              predicates:
                - Path=/api/v1/skutier/**

            - id: product-service-store
              uri: http://localhost:8082
              predicates:
                - Path=/api/v1/store/**

            - id: product-service-storeservicetype
              uri: http://localhost:8082
              predicates:
                - Path=/api/v1/storeservicetype/**

            - id: product-service-subservice
              uri: http://localhost:8082
              predicates:
                - Path=/api/v1/subservice/**

            - id: product-service-tier
              uri: http://localhost:8082
              predicates:
                - Path=/api/v1/tier/**

            - id: product-service-promotion
              uri: http://localhost:8082
              predicates:
                - Path=/api/v1/promotion/**

            - id: product-service-order-item-discount
              uri: http://localhost:8082
              predicates:
                - Path=/api/v1/order-item-discount/**

            - id: order-service-order
              uri: http://localhost:8083
              predicates:
                - Path=/api/v1/order/**

            - id: order-service-report
              uri: http://localhost:8083
              predicates:
                - Path=/api/v1/reports/settlement/**

            - id: order-service-daily-report
              uri: http://localhost:8083
              predicates:
                - Path=/api/v1/reports/daily/**

            - id: order-service-sales-report
              uri: http://localhost:8083
              predicates:
                - Path=/api/v1/reports/sales/**

management:
  endpoints:
    web:
      exposure:
        include: gateway,health
harmoni:
  auth:
    encryption:
      password: harmoni.pos
      salt: 
    jwt:
      secret: ${harmoni.auth.encryption.salt}
  gateway:
    rate-limit:
      max-requests: 100
      window-seconds: 60
    logging:
      max-body-chars: 4096